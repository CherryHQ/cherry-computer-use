{
  "name": "cherry-computer-use-repo-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/cli"
  ],
  "scripts": {
    "sdk:build": "npm run build --workspace @cherrystudio/computer-use",
    "sdk:check": "npm run check --workspace @cherrystudio/computer-use",
    "sdk:test": "npm run test --workspace @cherrystudio/computer-use",
    "npm:build": "node ./scripts/npm/build-packages.mjs",
    "npm:pack": "./scripts/release-package.sh",
    "npm:publish": "npm run changeset:publish",
    "package:skill": "./scripts/package-skill.sh",
    "release:notes:validate": "node ./scripts/validate-github-release-notes.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && node scripts/npm/sync-versions.mjs && npm install --package-lock-only --ignore-scripts",
    "changeset:publish": "bash scripts/publish-release.sh",
    "release:check": "node --test scripts/npm/release.test.mjs",
    "release:versions:check": "node scripts/npm/sync-versions.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "3.0.3"
  }
}
